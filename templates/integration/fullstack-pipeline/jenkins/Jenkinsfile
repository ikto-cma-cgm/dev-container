pipeline {
    agent none

    environment {
        NODE_VERSION = '${NODE_VERSION}'
        SERVICE_NAME = '${SERVICE_NAME}'
    }

    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Parallel CI') {
            parallel {
                stage('Frontend CI') {
                    agent {
                        docker {
                            image 'node:${NODE_VERSION}'
                            reuseNode true
                        }
                    }
                    stages {
                        stage('Frontend: Install') {
                            steps {
                                dir('frontend') {
                                    sh 'npm ci'
                                }
                            }
                        }
                        stage('Frontend: Lint') {
                            when {
                                expression { return ${RUN_LINT} }
                            }
                            steps {
                                dir('frontend') {
                                    sh 'npm run lint'
                                }
                            }
                        }
                        stage('Frontend: Test') {
                            when {
                                expression { return ${RUN_TESTS} }
                            }
                            steps {
                                dir('frontend') {
                                    sh 'npm run test'
                                }
                            }
                        }
                        stage('Frontend: Build') {
                            steps {
                                dir('frontend') {
                                    sh 'npm run build'
                                }
                            }
                        }
                    }
                }

                stage('Backend CI') {
                    agent {
                        docker {
                            image 'node:${NODE_VERSION}'
                            reuseNode true
                        }
                    }
                    stages {
                        stage('Backend: Install') {
                            steps {
                                dir('backend') {
                                    sh 'npm ci'
                                }
                            }
                        }
                        stage('Backend: Lint') {
                            when {
                                expression { return ${RUN_LINT} }
                            }
                            steps {
                                dir('backend') {
                                    sh 'npm run lint'
                                }
                            }
                        }
                        stage('Backend: Test') {
                            when {
                                expression { return ${RUN_TESTS} }
                            }
                            steps {
                                dir('backend') {
                                    sh 'npm run test'
                                }
                            }
                        }
                        stage('Backend: Build') {
                            steps {
                                dir('backend') {
                                    sh 'npm run build'
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('E2E Tests') {
            when {
                expression { return ${RUN_E2E_TESTS} }
            }
            agent any
            steps {
                sh '''
                    docker-compose up -d
                    sleep 30
                    cd frontend
                    npx playwright install --with-deps
                    npm run test:e2e
                    docker-compose down
                '''
            }
        }

        stage('Docker Build') {
            when {
                expression { return ${ENABLE_DOCKER} }
                branch '${DEFAULT_BRANCH}'
            }
            agent any
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY_URL}", 'docker-registry-credentials') {
                        parallel(
                            frontend: {
                                dir('frontend') {
                                    def frontendImage = docker.build(
                                        "${REGISTRY_URL}/${SERVICE_NAME}-frontend:${env.GIT_COMMIT_SHORT}"
                                    )
                                    frontendImage.push()
                                    frontendImage.push('latest')
                                }
                            },
                            backend: {
                                dir('backend') {
                                    def backendImage = docker.build(
                                        "${REGISTRY_URL}/${SERVICE_NAME}-backend:${env.GIT_COMMIT_SHORT}"
                                    )
                                    backendImage.push()
                                    backendImage.push('latest')
                                }
                            }
                        )
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression { return ${ENABLE_AUTO_DEPLOYMENT} && '${DEPLOYMENT_TARGET}' == 'kubernetes' }
                branch '${DEFAULT_BRANCH}'
            }
            agent any
            steps {
                withKubeConfig([credentialsId: 'kubernetes-credentials']) {
                    sh """
                        kubectl set image deployment/${SERVICE_NAME}-frontend \\
                            ${SERVICE_NAME}-frontend=${REGISTRY_URL}/${SERVICE_NAME}-frontend:${env.GIT_COMMIT_SHORT} \\
                            --namespace=${KUBERNETES_NAMESPACE}

                        kubectl set image deployment/${SERVICE_NAME}-backend \\
                            ${SERVICE_NAME}-backend=${REGISTRY_URL}/${SERVICE_NAME}-backend:${env.GIT_COMMIT_SHORT} \\
                            --namespace=${KUBERNETES_NAMESPACE}

                        kubectl rollout status deployment/${SERVICE_NAME}-frontend --namespace=${KUBERNETES_NAMESPACE}
                        kubectl rollout status deployment/${SERVICE_NAME}-backend --namespace=${KUBERNETES_NAMESPACE}
                    """
                }
            }
        }
    }

    post {
        always {
            sh 'docker-compose down || true'
            cleanWs()
        }
        success {
            echo 'Full-stack pipeline completed successfully!'
        }
        failure {
            echo 'Full-stack pipeline failed!'
        }
    }
}