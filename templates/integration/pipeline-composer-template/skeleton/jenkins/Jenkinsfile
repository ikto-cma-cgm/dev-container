/**
 * Jenkins CI/CD Pipeline
 * Generated by Pipeline Composer Template
 */

pipeline {
    agent any

    environment {
        {%- if values.projectType in ['nodejs', 'react', 'fullstack'] %}
        NODE_VERSION = '${{ values.nodeVersion }}'
        {%- endif %}
        {%- if values.projectType == 'java' %}
        JAVA_VERSION = '${{ values.javaVersion }}'
        {%- endif %}
        PROJECT_NAME = '${{ values.projectName }}'
        {%- if values.enableDocker %}
        REGISTRY_URL = credentials('docker-registry-url')
        REGISTRY_CREDENTIALS = credentials('docker-registry-credentials')
        {%- endif %}
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        // ============================================
        // STAGE 1: Build & Unit Tests
        // ============================================
        {%- if values.enableBuild or values.enableUnitTests or values.enableLinting %}
        stage('Build & Test') {
            {%- if values.projectType in ['nodejs', 'react', 'fullstack'] %}
            agent {
                docker {
                    image "node:${NODE_VERSION}-slim"
                    reuseNode true
                }
            }
            {%- elif values.projectType == 'java' %}
            agent {
                docker {
                    image "maven:3.9-eclipse-temurin-${JAVA_VERSION}"
                    reuseNode true
                }
            }
            {%- endif %}
            steps {
                {%- if values.projectType in ['nodejs', 'react', 'fullstack'] %}
                sh 'npm ci'
                {%- if values.enableLinting %}
                sh 'npm run lint'
                {%- endif %}
                {%- if values.enableUnitTests %}
                sh 'npm run test:coverage'
                {%- endif %}
                {%- if values.enableBuild %}
                sh 'npm run build'
                {%- endif %}
                {%- elif values.projectType == 'java' %}
                {%- if values.enableLinting %}
                sh 'mvn checkstyle:check'
                {%- endif %}
                {%- if values.enableUnitTests %}
                sh 'mvn test'
                {%- endif %}
                {%- if values.enableBuild %}
                sh 'mvn package -DskipTests'
                {%- endif %}
                {%- endif %}
            }
            post {
                always {
                    {%- if values.enableUnitTests %}
                    {%- if values.projectType in ['nodejs', 'react', 'fullstack'] %}
                    publishHTML(target: [
                        reportDir: 'coverage/lcov-report',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                    {%- elif values.projectType == 'java' %}
                    junit 'target/surefire-reports/*.xml'
                    {%- endif %}
                    {%- endif %}
                    {%- if values.enableBuild %}
                    archiveArtifacts artifacts: '{% if values.projectType == "java" %}target/*.jar{% else %}dist/**/*{% endif %}', fingerprint: true
                    {%- endif %}
                }
            }
        }
        {%- endif %}

        // ============================================
        // STAGE 2: Security Scanning
        // ============================================
        {%- if values.enableSecurityScan %}
        stage('Security Scan') {
            steps {
                sh '''
                    docker run --rm -v $(pwd):/project aquasec/trivy:latest fs \
                        --exit-code 0 \
                        --severity HIGH,CRITICAL \
                        --format json \
                        -o /project/trivy-results.json \
                        /project
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-results.json', allowEmptyArchive: true
                }
            }
        }
        {%- endif %}

        // ============================================
        // STAGE 3: SonarQube Analysis
        // ============================================
        {%- if values.enableSonarQube %}
        stage('SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        sonar-scanner \
                            -Dsonar.projectKey=${PROJECT_NAME} \
                            -Dsonar.sources=.
                    '''
                }
            }
            post {
                always {
                    timeout(time: 5, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: false
                    }
                }
            }
        }
        {%- endif %}

        // ============================================
        // STAGE 4: E2E Tests (WebDriverIO)
        // ============================================
        {%- if values.enableWebDriverIO %}
        stage('E2E Tests') {
            {%- if not values.wdioRunOnPR %}
            when {
                branch 'main'
            }
            {%- endif %}
            steps {
                script {
                    if (!fileExists('webdriver-io')) {
                        error 'webdriver-io/ directory not found. Please use the WebDriverIO template first.'
                    }
                }
                dir('webdriver-io') {
                    sh '''
                        export BASE_URL="${{ values.wdioBaseUrl }}"
                        docker-compose up --build --abort-on-container-exit --exit-code-from wdio-tests
                    '''
                }
            }
            post {
                always {
                    dir('webdriver-io') {
                        sh 'docker-compose down -v || true'
                    }
                    archiveArtifacts artifacts: 'webdriver-io/test-results/**/*', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'webdriver-io/allure-results/**/*', allowEmptyArchive: true
                    junit 'webdriver-io/test-results/*.xml'
                }
            }
        }
        {%- endif %}

        // ============================================
        // STAGE 5: Load Tests (JMeter)
        // ============================================
        {%- if values.enableJMeter %}
        stage('Load Tests') {
            {%- if not values.jmeterRunOnPR %}
            when {
                anyOf {
                    branch 'main'
                    triggeredBy 'UserIdCause'
                }
            }
            {%- endif %}
            steps {
                script {
                    if (!fileExists('jmeter')) {
                        error 'jmeter/ directory not found. Please use the JMeter template first.'
                    }
                }
                dir('jmeter') {
                    sh '''
                        export TARGET_HOST="${{ values.jmeterTargetHost }}"
                        export TARGET_PORT="${{ values.jmeterTargetPort }}"
                        export THREADS="${{ values.jmeterThreads }}"
                        export DURATION="${{ values.jmeterDuration }}"
                        docker-compose up --build --abort-on-container-exit --exit-code-from jmeter || true
                    '''
                }
            }
            post {
                always {
                    dir('jmeter') {
                        sh 'docker-compose down -v || true'
                    }
                    archiveArtifacts artifacts: 'jmeter/reports/**/*', allowEmptyArchive: true
                    archiveArtifacts artifacts: 'jmeter/results/**/*', allowEmptyArchive: true
                    perfReport sourceDataFiles: 'jmeter/results/*.jtl'
                }
            }
        }
        {%- endif %}

        // ============================================
        // STAGE 6: Docker Build
        // ============================================
        {%- if values.enableDocker %}
        stage('Docker Build') {
            when {
                branch 'main'
            }
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY_URL}", 'docker-registry-credentials') {
                        def image = docker.build("${REGISTRY_URL}/${PROJECT_NAME}:${env.GIT_COMMIT}")
                        image.push()
                        image.push('latest')
                    }
                }
            }
        }
        {%- endif %}

        // ============================================
        // STAGE 7: Deployment
        // ============================================
        {%- if values.deploymentTarget == 'kubernetes' %}
        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                withKubeConfig([credentialsId: 'kubeconfig']) {
                    sh """
                        kubectl set image deployment/${PROJECT_NAME} \
                            ${PROJECT_NAME}=${REGISTRY_URL}/${PROJECT_NAME}:${env.GIT_COMMIT} \
                            --namespace=\${K8S_NAMESPACE}
                        kubectl rollout status deployment/${PROJECT_NAME} \
                            --namespace=\${K8S_NAMESPACE} \
                            --timeout=5m
                    """
                }
            }
        }
        {%- elif values.deploymentTarget == 'cloud-run' %}
        stage('Deploy to Cloud Run') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_SA_KEY')]) {
                    sh """
                        gcloud auth activate-service-account --key-file=\${GCP_SA_KEY}
                        gcloud run deploy ${PROJECT_NAME} \
                            --image=${REGISTRY_URL}/${PROJECT_NAME}:${env.GIT_COMMIT} \
                            --region=us-central1 \
                            --platform=managed
                    """
                }
            }
        }
        {%- elif values.deploymentTarget == 'aws-ecs' %}
        stage('Deploy to AWS ECS') {
            when {
                branch 'main'
            }
            steps {
                withAWS(credentials: 'aws-credentials', region: 'us-east-1') {
                    sh """
                        aws ecs update-service \
                            --cluster \${ECS_CLUSTER} \
                            --service ${PROJECT_NAME} \
                            --force-new-deployment
                    """
                }
            }
        }
        {%- endif %}
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
            // Add notification here (Slack, email, etc.)
        }
    }
}
