{
  "name": "${{ values.projectName }}",
  "version": "1.0.0",
  "description": "${{ values.description }}",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",{% if values.includeTests %}
    "test": "jest",
    "test:watch": "jest --watch",{% endif %}
    "lint": "eslint src/"
  },
  "keywords": [
    "notification",
    "chatbot",
    "integration",
    "backstage"
  ],
  "author": "${{ values.owner }}",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {{% if values.includeTests %}
    "jest": "^29.7.0",{% endif %}
    "eslint": "^8.54.0"
  }
}