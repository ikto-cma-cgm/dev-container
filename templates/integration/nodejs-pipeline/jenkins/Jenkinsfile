pipeline {
    agent {
        docker {
            image 'node:${NODE_VERSION}'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        NODE_VERSION = '${NODE_VERSION}'
        SERVICE_NAME = '${SERVICE_NAME}'
        REGISTRY_URL = credentials('docker-registry-url')
        REGISTRY_CREDENTIALS = credentials('docker-registry-credentials')
        DATABASE_URL = '${DATABASE_URL}'
        REDIS_URL = '${REDIS_URL}'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Lint') {
            when {
                expression { return ${RUN_LINT} }
            }
            steps {
                sh 'npm run lint'
            }
        }

        stage('Test') {
            when {
                expression { return ${RUN_TESTS} }
            }
            steps {
                script {
                    // Start database if needed
                    if (${REQUIRES_DATABASE}) {
                        sh '''
                            docker run -d --name test-db \\
                                -e POSTGRES_USER=postgres \\
                                -e POSTGRES_PASSWORD=postgres \\
                                -e POSTGRES_DB=test_db \\
                                -p 5432:5432 \\
                                postgres:16-alpine
                        '''
                    }

                    if (${REQUIRES_REDIS}) {
                        sh '''
                            docker run -d --name test-redis \\
                                -p 6379:6379 \\
                                redis:7-alpine
                        '''
                    }

                    // Wait for services
                    sh 'sleep 5'
                }

                sh '''
                    export CI=true
                    npm run test
                '''

                script {
                    // Cleanup
                    if (${REQUIRES_DATABASE}) {
                        sh 'docker rm -f test-db || true'
                    }
                    if (${REQUIRES_REDIS}) {
                        sh 'docker rm -f test-redis || true'
                    }
                }
            }
        }

        stage('Code Coverage') {
            when {
                expression { return ${ENABLE_CODE_COVERAGE} }
            }
            steps {
                sh 'npm run test:coverage'
                publishHTML([
                    reportDir: 'coverage',
                    reportFiles: 'index.html',
                    reportName: 'Code Coverage Report'
                ])
            }
        }

        stage('Security Scan') {
            when {
                expression { return ${ENABLE_SECURITY_SCAN} }
            }
            steps {
                sh 'npm audit --audit-level=moderate || true'
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression { return ${ENABLE_SONARQUBE} }
            }
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        sonar-scanner \\
                            -Dsonar.projectKey=${SERVICE_NAME} \\
                            -Dsonar.sources=src \\
                            -Dsonar.tests=tests
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Docker Build & Push') {
            when {
                expression { return ${ENABLE_DOCKER} }
                branch '${DEFAULT_BRANCH}'
            }
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY_URL}", 'docker-registry-credentials') {
                        def image = docker.build(
                            "${REGISTRY_URL}/${SERVICE_NAME}:${env.GIT_COMMIT_SHORT}",
                            "."
                        )
                        image.push()
                        image.push('latest')
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                expression { return ${ENABLE_AUTO_DEPLOYMENT} && '${DEPLOYMENT_TARGET}' == 'kubernetes' }
                branch '${DEFAULT_BRANCH}'
            }
            steps {
                script {
                    withKubeConfig([credentialsId: 'kubernetes-credentials']) {
                        sh """
                            kubectl set image deployment/${SERVICE_NAME} \\
                                ${SERVICE_NAME}=${REGISTRY_URL}/${SERVICE_NAME}:${env.GIT_COMMIT_SHORT} \\
                                --namespace=${KUBERNETES_NAMESPACE}

                            kubectl rollout status deployment/${SERVICE_NAME} \\
                                --namespace=${KUBERNETES_NAMESPACE} \\
                                --timeout=5m
                        """
                    }
                }
            }
        }

        stage('Deploy to Cloud Run') {
            when {
                expression { return ${ENABLE_AUTO_DEPLOYMENT} && '${DEPLOYMENT_TARGET}' == 'cloud-run' }
                branch '${DEFAULT_BRANCH}'
            }
            steps {
                script {
                    withCredentials([file(credentialsId: 'gcp-sa-key', variable: 'GCP_KEY_FILE')]) {
                        sh """
                            gcloud auth activate-service-account --key-file=\$GCP_KEY_FILE
                            gcloud run deploy ${SERVICE_NAME} \\
                                --image=${REGISTRY_URL}/${SERVICE_NAME}:${env.GIT_COMMIT_SHORT} \\
                                --region=us-central1 \\
                                --platform=managed
                        """
                    }
                }
            }
        }

        stage('Deploy to ECS') {
            when {
                expression { return ${ENABLE_AUTO_DEPLOYMENT} && '${DEPLOYMENT_TARGET}' == 'ecs' }
                branch '${DEFAULT_BRANCH}'
            }
            steps {
                script {
                    withAWS(credentials: 'aws-credentials') {
                        sh """
                            aws ecs update-service \\
                                --cluster ${ECS_CLUSTER} \\
                                --service ${SERVICE_NAME} \\
                                --force-new-deployment
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            // Cleanup
            sh 'docker rm -f test-db test-redis || true'
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
            // Send notification (email, Slack, etc.)
        }
    }
}