# WebdriverIO Test Configuration
# Copy this file to .env and adjust values as needed
#
# Usage: docker-compose --env-file .env up

# Application URL
BASE_URL=http://localhost:3000

# Browser Configuration
BROWSER=chrome
HEADLESS=true

# Test Execution
MAX_INSTANCES=5
TEST_TIMEOUT=60000
TEST_FRAMEWORK=mocha

# Logging
LOG_LEVEL=info

# Timezone
TZ=Europe/Paris
