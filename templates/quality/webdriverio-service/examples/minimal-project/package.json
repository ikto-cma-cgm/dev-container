{
  "name": "my-awesome-app-e2e-tests",
  "version": "1.0.0",
  "description": "WebdriverIO E2E tests for my-awesome-app",
  "scripts": {
    "test": "docker-compose up --abort-on-container-exit wdio-tests",
    "test:e2e": "wdio run wdio-config/wdio.conf.js",
    "test:ui": "HEADLESS=false docker-compose up --abort-on-container-exit wdio-tests",
    "test:debug": "docker-compose run --rm wdio-tests bash",
    "docker:build": "docker-compose build wdio-tests",
    "docker:up": "docker-compose up -d wdio-tests",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f wdio-tests",
    "docker:clean": "docker-compose down -v && docker rmi my-awesome-app-wdio-tests:latest && rm -rf test-results/* allure-results/*",
    "lint": "eslint tests/",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/mocha-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "@wdio/allure-reporter": "^8.40.0",
    "allure-commandline": "^2.29.0",
    "chai": "^4.5.0",
    "expect-webdriverio": "^4.14.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.24.0",
    "eslint": "^8.57.0",
    "eslint-plugin-wdio": "^8.24.12",
    "chromedriver": "^123.0.1",
    "wdio-chromedriver-service": "^8.1.1"
  },
  "keywords": [
    "webdriverio",
    "e2e",
    "testing",
    "automation"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
