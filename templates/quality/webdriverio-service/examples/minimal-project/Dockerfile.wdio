# WebdriverIO Test Runner - Dockerfile
# Project: my-awesome-app
#
# This Dockerfile provides a complete testing environment with:
# - Node.js 18
# - Chromium browser
# - All WebdriverIO dependencies pre-installed
#
# Usage:
#   docker-compose up wdio-tests    (recommended)
#   or
#   docker build -t my-awesome-app-tests .
#   docker run --rm my-awesome-app-tests

FROM node:18-slim

LABEL maintainer="your-team"
LABEL description="WebdriverIO E2E testing environment for my-awesome-app"

# Install Chromium and dependencies
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-driver \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for better security
RUN groupadd -r wdio -g 1000 && \
    useradd -r -g wdio -u 1000 -m -s /bin/bash wdio

# Set working directory
WORKDIR /tests

# Copy package files
COPY package*.json ./

# Install dependencies as root
RUN npm ci && npm cache clean --force

# Create directories for test artifacts
RUN mkdir -p \
    test-results/screenshots \
    test-results/videos \
    allure-results \
    allure-report && \
    chown -R wdio:wdio /tests

# Copy test files
COPY --chown=wdio:wdio . .

# Switch to non-root user
USER wdio

# Environment variables
ENV CHROME_BIN=/usr/bin/chromium \
    NODE_ENV=test \
    BASE_URL=http://localhost:3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node --version || exit 1

# Default command
CMD ["npm", "run", "test:e2e"]
