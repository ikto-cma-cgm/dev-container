{
  "name": "@your-company/webdriverio-service",
  "version": "1.0.0",
  "description": "WebdriverIO Testing Service - Pre-configured testing environment maintained by Quality Platform Team",
  "main": "index.js",
  "scripts": {
    "test:e2e": "wdio run ./wdio-config/wdio.conf.js",
    "test:e2e:ui": "HEADLESS=false wdio run ./wdio-config/wdio.conf.js",
    "test:debug": "wdio run ./wdio-config/wdio.conf.js --debug",
    "test:spec": "wdio run ./wdio-config/wdio.conf.js --spec",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "webdriverio",
    "e2e",
    "testing",
    "automation",
    "quality"
  ],
  "author": "Quality Platform Team",
  "license": "MIT",
  "dependencies": {
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/mocha-framework": "^8.40.0",
    "@wdio/jasmine-framework": "^8.40.0",
    "@wdio/cucumber-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "@wdio/dot-reporter": "^8.40.0",
    "@wdio/allure-reporter": "^8.40.0",
    "@wdio/junit-reporter": "^8.40.0",
    "@wdio/json-reporter": "^8.40.0",
    "wdio-html-nice-reporter": "^8.0.0",
    "allure-commandline": "^2.29.0",
    "chai": "^4.5.0",
    "expect-webdriverio": "^4.14.0",
    "chromedriver": "^123.0.1",
    "wdio-chromedriver-service": "^8.1.1",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.24.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
