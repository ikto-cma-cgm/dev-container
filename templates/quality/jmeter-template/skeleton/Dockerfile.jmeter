# Use the JMeter service as base image
# Replace with your registry URL if using a private registry
FROM your-registry.com/jmeter-service:latest

# Optional: Copy custom configuration
# COPY config/jmeter.properties /opt/jmeter/bin/jmeter.properties

# Optional: Copy custom test plans at build time
# COPY test-plans/ /jmeter/test-plans/

# Optional: Install additional JMeter plugins
# RUN /opt/jmeter/bin/PluginsManagerCMD.sh install jpgc-additional-plugin

# Work directory is already set to /jmeter in base image
WORKDIR /jmeter

# Entrypoint and CMD are inherited from base image
