# JMeter Load Testing Configuration
# Copy this file to .env and customize

# Target Configuration
TARGET_HOST=${{ values.targetUrl | replace("http://", "") | replace("https://", "") | split(":")[0] }}
TARGET_PORT=${{ values.targetUrl | replace("http://", "") | replace("https://", "") | split(":")[1] or "8080" }}
TARGET_PROTOCOL=${{ "https" if "https://" in values.targetUrl else "http" }}

# Load Configuration
THREADS=${{ values.defaultThreads }}
RAMP_UP=${{ values.defaultRampUp }}
DURATION=${{ values.defaultDuration }}

# Test Execution
TEST_PLAN=api/load-test.jmx
GENERATE_REPORT=true

# JVM Configuration (adjust based on load)
HEAP=-Xms1g -Xmx1g -XX:MaxMetaspaceSize=256m

# Timezone
TZ=Europe/Paris
