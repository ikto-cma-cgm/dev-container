{
  "name": "${{ values.projectName }}-e2e-tests",
  "version": "1.0.0",
  "description": "WebdriverIO E2E tests for ${{ values.projectName }}",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:docker",
    "test:local": "wdio run wdio-config/wdio.conf.js",
    "test:e2e": "npm run test:local",
    "test:docker": "docker-compose up --build --abort-on-container-exit wdio-tests",
    "test:ui": "HEADLESS=false npm run test:local",
    "test:debug": "docker-compose run --rm wdio-tests bash",
    "docker:build": "docker-compose build wdio-tests",
    "docker:up": "docker-compose up -d wdio-tests",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v && rm -rf test-results/* allure-results/*",
    "lint": "eslint tests/",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/${{ values.testFramework }}-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "@wdio/allure-reporter": "^8.40.0",
    "allure-commandline": "^2.29.0",
    "chai": "^4.5.0",
    "expect-webdriverio": "^4.14.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.24.0",
    "eslint": "^8.57.0",
    "eslint-plugin-wdio": "^8.24.12",
    "wdio-chromedriver-service": "^8.1.1",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}