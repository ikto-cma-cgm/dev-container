# WebdriverIO Test Runner - Dockerfile
# Project: ${{ values.projectName }}

ARG BASE_IMAGE=node:18-slim
FROM ${BASE_IMAGE}

LABEL maintainer="quality-team"

RUN apt-get update && apt-get install -y \
    chromium \
    chromium-driver \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r wdio -g 1001 && \
    useradd -r -g wdio -u 1001 -m -s /bin/bash wdio

WORKDIR /tests
COPY package*.json ./
RUN npm install && npm cache clean --force

RUN mkdir -p test-results/screenshots allure-results && \
    chown -R wdio:wdio /tests

COPY --chown=wdio:wdio . .
RUN chmod +x wait-for-url.sh

USER wdio

ENV CHROME_BIN=/usr/bin/chromium \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver \
    NODE_ENV=test \
    BASE_URL=http://host.docker.internal:3000

# Default command
ENTRYPOINT ["./wait-for-url.sh"]
CMD ["npm", "run", "test:e2e"]
