# JMeter Service Configuration
# Copy this file to .env and customize as needed

# Target Configuration
TARGET_HOST=localhost
TARGET_PORT=8080
TARGET_PROTOCOL=http

# Load Configuration
THREADS=10
RAMP_UP=10
DURATION=60

# Test Execution
TEST_PLAN=api/simple-load-test.jmx
GENERATE_REPORT=true

# JVM Configuration
HEAP=-Xms1g -Xmx1g -XX:MaxMetaspaceSize=256m

# Timezone
TZ=Europe/Paris
