# Copie ce fichier en .env et remplis les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# URL de base de l'API OpenAI-compatible (sans trailing slash)
# Exemples :
#   Ollama local     → http://host.docker.internal:11434/v1
#   vLLM via proxy   → http://host.docker.internal:8000/v1  (avec VLLM_HOST ci-dessous)
AI_API_BASE=http://host.docker.internal:11434/v1

# Clé API — pour Ollama, n'importe quelle valeur non-vide fonctionne
AI_API_KEY=ollama

# Nom du modèle tel que le serveur le connaît
# Exemples Ollama : qwen3:4b, llama3.2, codestral, deepseek-coder
AI_MODEL=qwen3:4b

# Proxy automatique — si le serveur est sur le réseau local (ex: vLLM sur autre machine),
# définir VLLM_HOST pour que le proxy socat soit démarré automatiquement sur ton Mac
# à chaque ouverture du devcontainer. Laisser commenté pour Ollama local.
# VLLM_HOST=192.168.0.23
# VLLM_PORT=8000
