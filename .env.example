# Copie ce fichier en .env et remplis les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# ── Token Copilot / gh CLI ────────────────────────────────────────────────────
# Utilisé par Copilot CLI et la commande gh.
# Injecté automatiquement par GitHub Codespaces — ne pas modifier.
# Nécessite les scopes : repo, read:org
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Token Backstage ───────────────────────────────────────────────────────────
# Token dédié à Backstage pour créer des repos GitHub via les Software Templates.
# Doit appartenir à un compte admin/owner de l'organisation cible.
# Scopes requis (Classic PAT) : repo, delete_repo, admin:org (read)
BACKSTAGE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
