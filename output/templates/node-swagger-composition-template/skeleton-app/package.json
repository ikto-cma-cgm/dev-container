{
  "name": "${{ values.name }}",
  "version": "0.1.0",
  "description": "${{ values.description }}",
  "main": "dist/index.js",
  "engines": {
    "node": "${{ values.nodeVersion }}"
  },
  "scripts": {
    "fetch-spec": "curl -fsSL ${{ values.swaggerUrl }} -o src/openapi.yaml",
    "generate-api": "openapi-generator-cli generate -i src/openapi.yaml -g typescript-express-server -o src/generated",
    "prebuild": "npm run fetch-spec && npm run generate-api",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@types/express": "^4.17.17",
    "@types/node": "^18.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
