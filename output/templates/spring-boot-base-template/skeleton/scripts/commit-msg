#!/bin/bash

# Get the proposed commit message file path (argument passed to the script)
message_file="$1"

# Check if the message file exists
if [ ! -f "$message_file" ]; then
  exit 0
fi

# Read the first line of the commit message in lowercase
head_line=$(head -n 1 "$message_file" | tr [:upper:] [:lower:])

type='^(fix|docs|format|refactor|test|component|feature|build|perf|revert|create|update|delete|remove|bug|defect).*'

# Check if the message starts with a keyword (e.g., fix, feat)
if [[ ! $head_line =~ $type ]]; then
  echo "Error: Please start your commit message with a descriptive keyword (e.g., fix, docs, format, refactor, test, component, feature, build, perf, revert, create, update, delete, remove, bug, defect)."
  echo "Your current message: $head_line"
  exit 1
fi

# If all checks pass, exit successfully (allowing commit)
exit 0