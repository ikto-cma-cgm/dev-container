# In the application local we define all the credentials
spring:
  application:
    name: camunda-adapter-template
    config:
       import: optional:application-messaging-flavor-local.yml
management:
 metrics:
   enable:
   # We only enable metrics related to our use case which is here case (other metrics can be enable e.g. jvm: true, tomcat: true to list them set all: true)
     all: false
     case: true
     zeebe: true
   registry:
     #active: cloudwatch
     cloudwatch:
       batch-size: 20
       step-in-seconds: 30
       namespace: ${app.cma.project-name}
   tags:
     project: ${app.cma.project-name} # here should be mentionned the global project name
     app: ${spring.application.name}  
  endpoints:
    web:
      exposure:
        include: metrics
camunda:
  client:
    mode: saas
    auth:
      client-id: XXXX
      client-secret: YYYY
    cluster-id: ZZZZ
    region: EEEE
app:
  cma:
    project-name: "Camunda Business Project"
    application-name: ${spring.application.name}
    core:
      security:
       oauth2:
         resource-server:
           - ping:
               jwk-cache-ttl: 24h
               jwk-cache-refresh: 24h
               jwk-set-uri: https://auth-pre.cma-cgm.com/ext/jwks
               identifier:
                 client_id:          
      cloud:
        aws:
          region: HHHH
          local:
            enable: true