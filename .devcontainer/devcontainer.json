// Un devcontainer.json est le "passeport" de ton environnement de développement.
// VS Code le lit et construit automatiquement un container Docker configuré exactement
// comme décrit ici — même machine, même résultat, pour tout le monde.
{
  "name": "Backstage Template Creator",
  // Image Docker de base : Node.js 20 sur Debian Bookworm.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  // Exécuté une seule fois à la création du container.
  // Installe les outils de développement : Backstage CLI, Yarn,
  // et Spectral CLI (pour valider les specs OpenAPI contre le ruleset HIP en ligne de commande,
  // en complément de l'extension VS Code stoplight.spectral qui lint en temps réel dans l'éditeur).
  "postCreateCommand": "bash .devcontainer/install-glab.sh && npm install -g @backstage/cli yarn @stoplight/spectral-cli && cd scripts && npm install && cd ..",
  // Tout ce qui concerne VS Code spécifiquement.
  "customizations": {
    "vscode": {
      // Extensions installées automatiquement dans le container.
      "extensions": [
        // GitHub Copilot — autocompletion IA dans l'éditeur (nécessite un compte GitHub avec Copilot actif)
        "GitHub.copilot",
        // GitHub Copilot Chat — interface de chat IA dans VS Code
        "GitHub.copilot-chat",
        // Validation YAML avec schémas JSON Schema (erreurs inline)
        "redhat.vscode-yaml",
        // Linter OpenAPI/Spectral — applique le ruleset HIP en temps réel pendant l'édition
        // d'une spec OpenAPI/Swagger (3 niveaux de validation : IDE → form Backstage → HIP gate).
        "stoplight.spectral",
        // Syntax highlighting pour Nunjucks (le langage de templating de Backstage)
        "ronnidc.nunjucks"
      ],
      "settings": {
        // Associe le schéma officiel Backstage aux fichiers catalog-info.yaml.
        // => VS Code valide la structure et propose de l'autocompletion.
        "yaml.schemas": {
          "https://json.schemastore.org/catalog-info.json": "**/catalog-info.yaml"
        },
        // Active les custom chat modes (.github/chat/*.chatmode.md) dans Copilot Chat.
        // Permet d'utiliser les agents spécialisés (api-designer, backstage-creator, etc.)
        // via le sélecteur de mode dans le panneau Copilot Chat.
        "chat.experimental.chatModeFiles": true
      }
    }
  },
  // Monte local-backstage, templates, documentation et generated-services sous mounted/ → regroupés dans l'explorer VS Code.
  "mounts": [
    "source=${localWorkspaceFolder}/../backstage,target=${containerWorkspaceFolder}/mounted/local-backstage,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../templates,target=${containerWorkspaceFolder}/mounted/templates,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../documentation,target=${containerWorkspaceFolder}/mounted/documentation,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../cma-backstage,target=${containerWorkspaceFolder}/mounted/cma-backstage,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/../generated-services,target=${containerWorkspaceFolder}/mounted/generated-services,type=bind,consistency=cached"
  ],
  // Docker charge le .env directement dans l'environnement du container au démarrage.
  // GH_TOKEN devient ainsi une variable d'environnement container, sans dépendre du shell Mac.
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.env"],
  // GITHUB_TOKEN = GH_TOKEN du container → lu par VS Code GitHub Auth Provider.
  // L'extension Copilot s'authentifie automatiquement avec ce compte, sans popup OAuth.
  "remoteEnv": {
    "GITHUB_TOKEN": "${containerEnv:GH_TOKEN}"
  },
  // Ports du container exposés sur ta machine hôte.
  "forwardPorts": [
    3000,
    7007
  ],
  "portsAttributes": {
    "3000": {
      "label": "Backstage Frontend"
    },
    "7007": {
      "label": "Backstage Backend"
    }
  }
}